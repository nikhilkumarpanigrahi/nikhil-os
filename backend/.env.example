# ─────────────────────────────────────────────────────────────────────────────
# NIKHIL//OS backend — environment contract
# Copy to `.env`, fill in real values, and never commit `.env`.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string for LOCAL dev / tests only. Inside docker-compose
# DATABASE_URL is computed from POSTGRES_* below — leave it unset on the server.
DATABASE_URL=postgres://nikhilos:nikhilos_dev_pw@localhost:5432/nikhilos

# Argon2id hash of the admin password (used by /admin login).
# Generate with:  cargo run --bin hashgen
# e.g.  $argon2id$v=19$m=19456,t=2,p=1$...
ADMIN_PASSWORD_HASH=

# Long random secret that signs the admin JWTs. 32+ bytes.
# Generate with:  openssl rand -base64 48
ADMIN_JWT_SECRET=

# ── Domain (Caddy auto-HTTPS) ────────────────────────────────────────────────
# Free subdomain containing your name. Recommended: api.nikhil.is-a.dev
# (free forever, Cloudflare-backed; register via a PR to is-a.dev/is-a-dev).
# Instant fallback: nikhil.duckdns.org.
DOMAIN=api.nikhil.is-a.dev

# ── Postgres (docker-compose) ────────────────────────────────────────────────
POSTGRES_DB=nikhilos
POSTGRES_USER=nikhilos
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from the browser. Include the
# GitHub Pages site and localhost for dev.
CORS_ALLOWED_ORIGINS=https://nikhilkumarpanigrahi.github.io,http://localhost:5173,http://localhost:4173

# ── Alerts (Telegram) ────────────────────────────────────────────────────────
# Create a bot via @BotFather → get the token. Find your chat id via @userinfobot.
# Leave empty to fall back to structured logging (alerts won't be pushed).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Optional tuning ──────────────────────────────────────────────────────────
# Admin JWT lifetime in seconds (default 900 = 15 min).
ADMIN_JWT_TTL_SECS=900
# Per-IP contact submissions per minute (default 10, clamped 1..=60).
CONTACT_RATE_LIMIT=10
# Per-IP admin login attempts per minute (default 20, clamped 1..=120).
LOGIN_RATE_LIMIT=20
# Log output: "json" (prod) or "pretty" (dev). Overridden to json in compose.
LOG_FORMAT=pretty
# Bind address (default 0.0.0.0:8080).
BIND_ADDR=0.0.0.0:8080
